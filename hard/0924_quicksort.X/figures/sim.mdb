# MDB script: dump the array before and after the sort.
# Build first (make CONF=default build), then run from the lab folder:
#   mdb.sh figures/sim.mdb > sim.log
#   python3 figures/plot_ram_heatmap.py sim.log
# 0x0020 = MAIN (data loader finished), 0x00CE = terminate loop (sort finished);
# addresses from build/default/production/hard_924.lst.
device PIC18F4520
hwtool sim
program dist/default/production/0924_quicksort.X.production.cof
break *0x20
break *0xCE
run
wait 20000
stopwatch
x /r/256/x/b 0x100
run
wait 120000
stopwatch
x /r/256/x/b 0x100
quit
